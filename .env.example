# Frontend: leave blank locally (Vite proxy); set Railway URL in Vercel.
VITE_API_BASE_URL=

# Railway backend only. Railway injects PORT automatically.
# NODE_ENV=production
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=innohack
FRONTEND_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app

# Generate two different random secrets (at least 32 characters each).
INNOHACK_AUTH_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
INNOHACK_SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
INNOHACK_ADMIN_PASSCODE=REPLACE_WITH_STRONG_ADMIN_PASSCODE_AT_LEAST_32_CHARS

# Local development: leave MONGODB_URI and production secrets unset to use local JSON mode.
# Never commit this file or expose backend secrets with a VITE_ prefix.
